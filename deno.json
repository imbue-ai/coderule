{
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@latest",
    "@std/assert": "jsr:@std/assert@1",
    "@std/cli": "jsr:@std/cli@1"
  },
  "tasks": {
    "start": "deno run --allow-run --allow-read --allow-env --allow-net src/main.ts",
    "test": "deno test --allow-run --allow-read --allow-write --allow-env --allow-net tests/",
    "test:unit": "deno test --allow-run --allow-read --allow-write --allow-env tests/unit/",
    "test:integration": "deno test --allow-run --allow-read --allow-write --allow-env tests/integration/",
    "test:e2e": "CODERULE_E2E=1 deno test --allow-run --allow-read --allow-write --allow-env --allow-net tests/e2e/"
  },
  "compilerOptions": {
    "strict": true
  }
}
